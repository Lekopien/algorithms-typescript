// Cloudflare Worker (free plan) that serves the showcase site at https://algo.lekopien.com
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lekopien-algo",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "algo.lekopien.com", "custom_domain": true }]
}
